<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- xunit.v3 exige un projet de test exécutable. -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>PressePapiers.Tests</RootNamespace>
    <AssemblyName>PressePapiers.Tests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PressePapiers.Coeur\PressePapiers.Coeur.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Logique pure de l'interface (aucun contrôle WinUI), compilée ici pour être testée sans l'application. -->
    <Compile Include="..\..\src\PressePapiers\Interface\ResumeElement.cs" Link="Interface\ResumeElement.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
